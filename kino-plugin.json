{
  "id": "flixlatam",
  "name": "FlixLatam",
  "version": "1.2.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Hecho por Hotaru Yume. FlixLatam: series, películas y anime en latino",
  "author": "Hotaru Yume",
  "homepage": "https://flixlatam.com",
  "browser": "pages",
  "hosts": [
    "flixlatam.com",
    "*.flixlatam.com",
    "embed69.org",
    "*.embed69.org",
    "image.tmdb.org",
    "swhoi.com",
    "*.swhoi.com",
    "hglink.to",
    "*.hglink.to",
    "strwish.com",
    "*.strwish.com",
    "streamwish.to",
    "*.streamwish.to",
    "streamwish.com",
    "*.streamwish.com",
    "premilkyway.com",
    "*.premilkyway.com",
    "sirenglyph.com",
    "*.sirenglyph.com",
    "voe.sx",
    "*.voe.sx",
    "morencius.com",
    "*.morencius.com",
    "filemoon.sx",
    "*.filemoon.sx",
    "vidhidevip.com",
    "*.vidhidevip.com",
    "vidhidepre.com",
    "*.vidhidepre.com",
    "dood.watch",
    "*.dood.watch",
    "waaw.to",
    "*.waaw.to",
    "netu.tv",
    "*.netu.tv",
    "hqq.tv",
    "*.hqq.tv",
    "rapidvideo.link",
    "*.rapidvideo.link"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "color": "#1E40AF",
  "icon": "icon.png",
  "theme": {
    "accent": "#3B82F6",
    "onAccent": "#FFFFFF",
    "background": "#0F172A",
    "surface": "#1E293B",
    "highlight": "#60A5FA"
  },
  "settings": [
    {
      "key": "preferLang",
      "label": "Audio preferido",
      "type": "select",
      "default": "LAT",
      "options": [
        {
          "value": "LAT",
          "label": "Latino"
        },
        {
          "value": "ESP",
          "label": "Castellano"
        },
        {
          "value": "SUB",
          "label": "Subtitulado"
        },
        {
          "value": "ENG",
          "label": "Inglés"
        },
        {
          "value": "auto",
          "label": "Automático"
        }
      ]
    },
    {
      "key": "preferServer",
      "label": "Servidor preferido",
      "type": "select",
      "default": "streamwish",
      "options": [
        {
          "value": "auto",
          "label": "Automático"
        },
        {
          "value": "streamwish",
          "label": "Streamwish"
        },
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "filemoon",
          "label": "Filemoon"
        },
        {
          "value": "vidhide",
          "label": "Vidhide"
        },
        {
          "value": "rapidvideo",
          "label": "Rapidvideo"
        }
      ]
    }
  ]
}